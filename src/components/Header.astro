---
import { business, navigation, links } from '../data/home'
import Arrow from './Arrow.astro'
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isReservationPage = currentPath === links.reservation
const pageLinks = navigation.filter((item) => item.href !== links.reservation)
---

<a class="skip-link" href="#inhoud">Naar de inhoud</a>
<div class="topbar">
  <div class="container flex items-center justify-between gap-4">
    <a href={business.directions}>{business.street}<span class="hidden sm:inline"> · {business.locality}</span></a>
    <a href={business.phoneHref}>{business.telephone}</a>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Het Landerhuys — home"
      ><img src="/images/landerhuys-logo.webp" width="800" height="156" alt="Het Landerhuys" /></a
    >
    <nav class="site-nav" aria-label="Hoofdnavigatie">
      <button class="menu-toggle" type="button" popovertarget="site-menu" aria-controls="site-menu">
        Menu
        <svg
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        >
          <path class="menu-icon" d="M2.5 6.5h15m-15 7h15"></path>
          <path class="close-icon" d="m4.5 4.5 11 11m0-11-11 11"></path>
        </svg>
      </button>
      <div class="site-menu" id="site-menu" popover="auto">
        <ul class="site-links">
          {
            pageLinks.map((item) => (
              <li>
                <a href={item.href} aria-current={item.href === currentPath ? 'page' : undefined}>
                  {item.label} <Arrow />
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="menu-contact">
          <li><a href={business.phoneHref}>{business.telephone}</a></li>
          <li><a href={business.directions}>Route plannen</a></li>
        </ul>
        <a class="menu-reserve" href={links.reservation} aria-current={isReservationPage ? 'page' : undefined}>
          Reserveren <Arrow />
        </a>
      </div>
    </nav>
    <a class="button header-reserve" href={links.reservation} aria-current={isReservationPage ? 'page' : undefined}>
      Een tafel reserveren <Arrow />
    </a>
  </div>
</header>
<script>
  const header = document.querySelector('.site-header')
  const menu = header?.querySelector<HTMLElement>('#site-menu')
  const trigger = header?.querySelector<HTMLButtonElement>('.menu-toggle')
  if (header && menu && trigger) {
    const wide = window.matchMedia('(min-width: 68.75rem)')
    const supportsPopover = typeof menu.showPopover === 'function'

    const syncNavigation = () => {
      const active = document.activeElement
      const focusInMenu = menu.contains(active)

      if (wide.matches) {
        const focusedLink = menu.querySelector<HTMLAnchorElement>('.site-links a:focus')
        const focusedReservation = active?.matches('.menu-reserve')
        menu.removeAttribute('popover')
        header.classList.add('is-wide')
        if (active === trigger || focusInMenu) {
          const reserve = header.querySelector<HTMLAnchorElement>('.header-reserve')
          const currentLink = menu.querySelector<HTMLAnchorElement>('.site-links [aria-current="page"]')
          const link = focusedLink ?? (focusedReservation ? reserve : currentLink) ?? reserve
          link?.focus({ preventScroll: true })
        }
        return
      }

      menu.setAttribute('popover', 'auto')
      header.classList.remove('is-wide')
      if (focusInMenu && supportsPopover) {
        trigger.focus({ preventScroll: true })
      }
    }

    syncNavigation()
    wide.addEventListener('change', syncNavigation)

    menu.addEventListener('click', (event) => {
      const target = event.target
      if (supportsPopover && menu.matches(':popover-open') && target instanceof Element && target.closest('a[href]')) {
        menu.hidePopover()
      }
    })
  }
</script>
