---
import '../styles/global.css'
import { business, copy, links } from '../data/home'
interface Props {
  title?: string
  description?: string
}
const { title = 'Het Landerhuys | Grand café in Stal-Koersel', description = copy.reservation } = Astro.props
const indexable = import.meta.env.PROD && import.meta.env.PUBLIC_INDEXABLE === 'true'
const site = Astro.site ?? new URL('https://landerhuys.be')
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/'
const canonical = new URL(pathname, site).href
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: business.name,
  '@id': new URL('/#restaurant', site).href,
  url: site.href,
  telephone: business.telephone,
  vatID: business.vat,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.street,
    postalCode: '3582',
    addressLocality: 'Stal - Koersel',
    addressCountry: 'BE',
  },
  hasMenu: new URL(links.menu, site).href,
  acceptsReservations: new URL(links.reservation, site).href,
  // The homepage supplies opening times, but no restaurant closing time.
  // Keep its kitchen closing time out of openingHoursSpecification.
}
---

<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#263D32" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://landerhuys.be/images/social.jpg" />
    <meta property="og:image:alt" content="Het Landerhuys met de veranda, het terras en de bloeiende tuin" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body><slot /></body>
</html>
