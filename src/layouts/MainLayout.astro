---
import '../styles/global.css'
import { business, copy, links } from '../data/home'
const indexable = import.meta.env.PROD && import.meta.env.PUBLIC_INDEXABLE === 'true'
const canonical = 'https://landerhuys.be/'
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: business.name,
  url: canonical,
  telephone: business.telephone,
  vatID: business.vat,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.street,
    postalCode: '3582',
    addressLocality: 'Stal - Koersel',
    addressCountry: 'BE',
  },
  hasMenu: links.menu,
  acceptsReservations: links.reservation,
  // The homepage supplies opening times, but no restaurant closing time.
  // Keep its kitchen closing time out of openingHoursSpecification.
}
---

<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#263D32" />
    <title>Het Landerhuys | Grand café in Stal-Koersel</title>
    <meta name="description" content={copy.reservation} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:title" content="Het Landerhuys | Grand café in Stal-Koersel" />
    <meta property="og:description" content={copy.reservation} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://landerhuys.be/images/social.jpg" />
    <meta property="og:image:alt" content="Bloemen uit de seizoensfotografie van Het Landerhuys" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body><slot /></body>
</html>
